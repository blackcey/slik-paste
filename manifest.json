{
  "manifest_version": 3,
  "name": "SLIK Paste",
  "version": "1.3.1",
  "description": "Right-click to paste a clipboard list into any text field as an IFS search filter — precise (=x;=y;) or numeric/starts-with (x;y).",
  "author": "SLIK Consulting Ltd",
  "homepage_url": "https://www.slikconsulting.com",
  "minimum_chrome_version": "109",
  "permissions": ["contextMenus", "scripting", "clipboardRead", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SLIK Paste",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
